                }
                return;
            }

            // Запрещаем рисование внутри любых виджетов, КРОМЕ фото-виджета (.photo-widget)
            if (e.target.closest('.widget') && !e.target.closest('.photo-widget')) return;

            if (tool === 'pan') {
                if (role === 'student' && followMode) return;
                panning = true;
                startPanX = e.clientX - boardX;
                startPanY = e.clientY - boardY;
                viewport.style.cursor = 'grabbing';
            } else if (tool === 'pointer') {
                const pt = screenToWorld(e.clientX, e.clientY);
                laserCursor.style.display = 'block';
                laserCursor.style.left = pt.x + 'px';
                laserCursor.style.top = pt.y + 'px';
            } else if (tool === 'text') {
                const pt = screenToWorld(e.clientX, e.clientY);
                const fontSize = Math.max(20, Math.min(54, 14 + baseStrokeSize * 2));
                const textData = {
                    id: 'text-' + Date.now(),
                    left: Math.round(pt.x), top: Math.round(pt.y - 14),
                    color: currentColor, fontSize, text: ''
                };
                createTextNode(textData, true, true);
            } else {
                drawing = true;
                const pt = screenToWorld(e.clientX, e.clientY);
                currentStrokePoints = [pt];
                strokeBounds = { minX: pt.x, minY: pt.y, maxX: pt.x, maxY: pt.y };
            }
        });

        viewport.addEventListener('pointermove', (e) => {
            const pt = screenToWorld(e.clientX, e.clientY);
            const worldX = Math.round(pt.x);
            const worldY = Math.round(pt.y);

            if (panning) {
                boardX = e.clientX - startPanX;
                boardY = e.clientY - startPanY;
                applyBoardTransform();
            } else if (drawing && tool !== 'pointer' && tool !== 'pan' && tool !== 'text') {
                currentStrokePoints.push({ x: worldX, y: worldY });
                const pad = getToolWidth(tool, baseStrokeSize) + 10;

                if (tool === 'highlighter') {
                    clearTempBounds(strokeBounds, pad);
                    strokeBounds.minX = Math.min(strokeBounds.minX, worldX);
                    strokeBounds.minY = Math.min(strokeBounds.minY, worldY);
                    strokeBounds.maxX = Math.max(strokeBounds.maxX, worldX);
                    strokeBounds.maxY = Math.max(strokeBounds.maxY, worldY);
                    renderSmoothPath(tempCtx, currentStrokePoints, currentColor, tool, baseStrokeSize);
                } else {
                    const len = currentStrokePoints.length;
                    const p0 = currentStrokePoints[len - 2];
                    const p1 = currentStrokePoints[len - 1];
                    renderSmoothPath(ctx, [p0, p1], currentColor, tool, baseStrokeSize);
                    broadcastEvent({
                        type: 'draw_seg', p0, p1, color: currentColor, strokeTool: tool, size: baseStrokeSize
                    });
                }
            }

            if (role === 'teacher') {
                const pointerActive = (tool === 'pointer');
                laserCursor.style.display = pointerActive ? 'block' : 'none';
                if (pointerActive) {
                    laserCursor.style.left = worldX + 'px';
                    laserCursor.style.top = worldY + 'px';
                }

                const now = Date.now();
                if (now - lastMoveSentTime > 40) {
                    lastMoveSentTime = now;
                    sendTeacherViewportSync(worldX, worldY);
                }
            }
        });

        window.addEventListener('pointerup', () => {
            if (drawing && currentStrokePoints.length > 0 && tool !== 'pointer' && tool !== 'pan' && tool !== 'text') {
                if (tool === 'highlighter') {
                    const pad = getToolWidth(tool, baseStrokeSize) + 15;
                    clearTempBounds(strokeBounds, pad);
                    renderSmoothPath(ctx, currentStrokePoints, currentColor, tool, baseStrokeSize);
                }
                const finishedStroke = {
                    points: currentStrokePoints,
                    color: currentColor,
                    strokeTool: tool,
                    size: baseStrokeSize
                };
                strokeHistory.push(finishedStroke);
                recordAction({ kind: 'stroke', stroke: finishedStroke });
                broadcastEvent({ type: 'draw_commit', stroke: finishedStroke });
            }
            drawing = false;
            panning = false;
            currentStrokePoints = [];
            if (tool === 'pan' && !pendingWidgetType) viewport.style.cursor = 'grab';
        });

