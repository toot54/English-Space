        function createTextNode(existingData, broadcast, recordInHistory = true) {
            if (document.getElementById(existingData.id)) return;
            const fontSize = existingData.fontSize || Math.max(20, Math.min(54, 14 + baseStrokeSize * 2));
            const data = { ...existingData, fontSize };

            const node = document.createElement('div');
            node.className = 'board-text-node';
            node.id = data.id;
            node.dataset.type = 'text';
            node.dataset.color = data.color;
            node.dataset.fontSize = fontSize;
            node.style.left = data.left + 'px';
            node.style.top = data.top + 'px';

            node.innerHTML = `
                <div class="board-text-drag">⠿</div>
                <div class="board-text-content" contenteditable="true" spellcheck="false"
                     style="color: ${data.color}; font-size: ${fontSize}px;">${data.text || ''}</div>
                <button class="board-text-del" onclick="removeDynamicItem('${data.id}', true)">✕</button>
                <div class="text-resize-handle">◢</div>
            `;

            dynamicItems.appendChild(node);

            const contentEl = node.querySelector('.board-text-content');
            const dragEl = node.querySelector('.board-text-drag');
            const resizeEl = node.querySelector('.text-resize-handle');

            contentEl.addEventListener('input', () => {
                saveBoardState();
                broadcastEvent({ type: 'text_node_update', id: data.id, text: contentEl.innerText });
            });

            let draggingText = false, resizingText = false;
            let startX = 0, startY = 0, origL = 0, origT = 0, origFont = fontSize;

            dragEl.addEventListener('pointerdown', (e) => {
                if (role === 'student') return;
                e.stopPropagation();
                draggingText = true;
                startX = e.clientX; startY = e.clientY;
                origL = node.offsetLeft; origT = node.offsetTop;
            });

            resizeEl.addEventListener('pointerdown', (e) => {
                if (role === 'student') return;
                e.stopPropagation();
                resizingText = true;
                startX = e.clientX; startY = e.clientY;
                origFont = parseFloat(node.dataset.fontSize) || 24;
            });

            window.addEventListener('pointermove', (e) => {
                if (draggingText) {
                    const left = Math.round(origL + (e.clientX - startX) / boardScale);
                    const top = Math.round(origT + (e.clientY - startY) / boardScale);
                    node.style.left = left + 'px';
                    node.style.top = top + 'px';
                    broadcastEvent({ type: 'widget_move', id: data.id, left, top });
                } else if (resizingText) {
                    const delta = ((e.clientX - startX) + (e.clientY - startY)) / (2 * boardScale);
                    const newFont = Math.max(14, Math.min(120, Math.round(origFont + delta * 0.35)));
                    node.dataset.fontSize = newFont;
                    contentEl.style.fontSize = newFont + 'px';
                    broadcastEvent({ type: 'text_node_resize', id: data.id, fontSize: newFont });
                }
            });

            window.addEventListener('pointerup', () => {
                if (draggingText && (node.offsetLeft !== origL || node.offsetTop !== origT)) {
                    recordAction({ kind: 'move_item', id: data.id, fromLeft: origL, fromTop: origT, toLeft: node.offsetLeft, toTop: node.offsetTop });
                }
                draggingText = false; resizingText = false;
            });

            if (recordInHistory) recordAction({ kind: 'add_item', id: data.id, display: 'flex' });
            if (broadcast) {
                broadcastEvent({ type: 'spawn_text_node', data });
                setTimeout(() => contentEl.focus(), 20);
            }
        }

        function makeWidgetInteractive(widget, aspectRatio) {
            const header = widget.querySelector('.widget-header');
            const resizeHandle = widget.querySelector('.resize-handle');

            let isDragging = false, startX = 0, startY = 0, origLeft = 0, origTop = 0;
            let isResizing = false, origW = 0, origH = 0;

            widget.addEventListener('pointerdown', () => bringToFront(widget));

            if (header) {
                header.addEventListener('pointerdown', (e) => {
                    if (role === 'student' || widget.classList.contains('locked-widget')) return;
                    if (e.target.closest('button') || e.target.closest('label') || e.target.closest('.sticker-dot')) return;
                    e.stopPropagation();
                    bringToFront(widget);
                    isDragging = true;
                    startX = e.clientX; startY = e.clientY;
                    origLeft = widget.offsetLeft; origTop = widget.offsetTop;
                });
            }

            if (resizeHandle) {
                resizeHandle.addEventListener('pointerdown', (e) => {
                    if (role === 'student' || widget.classList.contains('locked-widget')) return;
                    e.stopPropagation();
                    bringToFront(widget);
                    isResizing = true;
                    startX = e.clientX; startY = e.clientY;
                    origW = widget.offsetWidth; origH = widget.offsetHeight;
                });
            }

            window.addEventListener('pointermove', (e) => {
                if (isDragging) {
                    const left = Math.round(origLeft + (e.clientX - startX) / boardScale);
                    const top = Math.round(origTop + (e.clientY - startY) / boardScale);
                    widget.style.left = left + 'px';
                    widget.style.top = top + 'px';
                    broadcastEvent({ type: 'widget_move', id: widget.id, left, top });
                } else if (isResizing) {
                    const minW = parseInt(widget.dataset.minW || 180, 10);
                    const minH = parseInt(widget.dataset.minH || 130, 10);
                    const newW = Math.max(minW, Math.round(origW + (e.clientX - startX) / boardScale));
                    let newH;
                    if (aspectRatio) {
                        newH = Math.max(minH, Math.round((newW - 12) / aspectRatio) + 32);
                    } else {
                        newH = Math.max(minH, Math.round(origH + (e.clientY - startY) / boardScale));
                    }
                    widget.style.width = newW + 'px';
                    widget.style.height = newH + 'px';
                    broadcastEvent({ type: 'widget_resize', id: widget.id, width: newW, height: newH });
                }
            });

            window.addEventListener('pointerup', () => {
                if (isDragging && (widget.offsetLeft !== origLeft || widget.offsetTop !== origTop)) {
                    recordAction({
                        kind: 'move_item', id: widget.id,
                        fromLeft: origLeft, fromTop: origTop,
                        toLeft: widget.offsetLeft, toTop: widget.offsetTop
                    });
                } else if (isResizing && (widget.offsetWidth !== origW || widget.offsetHeight !== origH)) {
                    recordAction({
                        kind: 'resize_item', id: widget.id,
                        fromW: origW, fromH: origH,
                        toW: widget.offsetWidth, toH: widget.offsetHeight
                    });
                }
                isDragging = false; isResizing = false;
            });
        }

        // ================= ВИДЕО-ВИДЖЕТ С ПАКЕТНОЙ ПЕРЕДАЧЕЙ ФАЙЛА И ЗВУКА УЧЕНИКУ =================
        function createVideoWidget(existingData, broadcast, recordInHistory = true) {
