            if (e.target.closest('.widget') || e.target.closest('.board-text-node')) return;
            e.preventDefault();
            const delta = e.deltaY < 0 ? 0.1 : -0.1;
            changeZoom(delta, e.clientX, e.clientY);
        }, { passive: false });

        let lastPinchDist = null;
        viewport.addEventListener('touchstart', (e) => {
            if (e.touches.length === 2) {
                drawing = false;
                panning = false;
                const dx = e.touches[0].clientX - e.touches[1].clientX;
                const dy = e.touches[0].clientY - e.touches[1].clientY;
                lastPinchDist = Math.hypot(dx, dy);
            }
        }, { passive: false });

        viewport.addEventListener('touchmove', (e) => {
            if (e.touches.length === 2 && lastPinchDist !== null) {
                e.preventDefault();
                const dx = e.touches[0].clientX - e.touches[1].clientX;
                const dy = e.touches[0].clientY - e.touches[1].clientY;
                const dist = Math.hypot(dx, dy);
                const centerX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
                const centerY = (e.touches[0].clientY + e.touches[1].clientY) / 2;
                const diff = dist - lastPinchDist;
                if (Math.abs(diff) > 6) {
                    changeZoom(diff > 0 ? 0.04 : -0.04, centerX, centerY);
                    lastPinchDist = dist;
                }
            }
        }, { passive: false });

        viewport.addEventListener('touchend', () => { lastPinchDist = null; });

        function screenToWorld(clientX, clientY) {
