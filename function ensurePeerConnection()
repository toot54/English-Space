        function applyBoardTransform() {
            const minX = Math.min(0, window.innerWidth - canvas.width * boardScale);
            const minY = Math.min(0, window.innerHeight - canvas.height * boardScale);
            boardX = Math.min(0, Math.max(minX, boardX));
            boardY = Math.min(0, Math.max(minY, boardY));
            boardWorld.style.transform = `translate3d(${boardX}px, ${boardY}px, 0) scale(${boardScale})`;
            const step = +(28 * boardScale).toFixed(2);
            viewport.style.backgroundColor = '#f8fafc';
            viewport.style.backgroundImage = 'radial-gradient(#cbd5e1 1.5px, transparent 1.5px)';
            viewport.style.backgroundSize = `${step}px ${step}px`;
            viewport.style.backgroundPosition = `${boardX}px ${boardY}px`;
        }

        function getToolWidth(strokeTool, size) {
            if (strokeTool === 'eraser') return size * 5;
            if (strokeTool === 'pencil') return Math.max(2, size * 0.85);
            if (strokeTool === 'highlighter') return size * 4.5;
            return size;
        }

        function renderSmoothPath(targetCtx, points, color, strokeTool, size) {
            if (!points || points.length === 0) return;
            targetCtx.save();
            targetCtx.beginPath();
            targetCtx.moveTo(points[0].x, points[0].y);
            for (let i = 1; i < points.length; i++) {
                targetCtx.lineTo(points[i].x, points[i].y);
            }
            if (points.length === 1) {
                targetCtx.lineTo(points[0].x + 0.1, points[0].y + 0.1);
            }

            targetCtx.lineWidth = getToolWidth(strokeTool, size);
            if (strokeTool === 'eraser') {
                targetCtx.globalCompositeOperation = 'destination-out';
            } else if (strokeTool === 'highlighter') {
                targetCtx.globalCompositeOperation = 'source-over';
                targetCtx.strokeStyle = color;
                targetCtx.globalAlpha = 0.28;
            } else if (strokeTool === 'pencil') {
                targetCtx.globalCompositeOperation = 'source-over';
                targetCtx.strokeStyle = getPencilPattern(color);
                targetCtx.globalAlpha = 0.9;
            } else {
                targetCtx.globalCompositeOperation = 'source-over';
                targetCtx.strokeStyle = color;
            }
            targetCtx.stroke();
            targetCtx.restore();
        }

        function clearTempBounds(bounds, pad) {
            const x = Math.max(0, bounds.minX - pad);
            const y = Math.max(0, bounds.minY - pad);
            const w = (bounds.maxX - bounds.minX) + pad * 2;
            const h = (bounds.maxY - bounds.minY) + pad * 2;
            tempCtx.clearRect(x, y, w, h);
        }

