        function loadLocalMediaFor(event, id) {
            const file = event.target.files[0];
            const v = document.querySelector(`#${id} video`);
            const btnLabel = document.getElementById(`vid-btn-label-${id}`);
            if (!file || !v) return;

            v.src = URL.createObjectURL(file);
            v.muted = false;

            if (file.size > 45 * 1024 * 1024) {
                alert('Файл слишком большой (более 45 МБ). Выберите ролик покороче для быстрой отправки ученику.');
                return;
            }

            if (btnLabel) btnLabel.innerText = '⏳ Загрузка видео для ученика: 0%...';

            const reader = new FileReader();
            reader.onload = async (e) => {
                const fullDataUrl = e.target.result;
                if (!roomRef) return;

                try {
                    const chunkSize = 350000; // По 350 КБ на пакет (безопасно для Firebase RTDB)
                    const totalChunks = Math.ceil(fullDataUrl.length / chunkSize);
                    const videoNodeRef = roomRef.child('videoFiles/' + id);

                    await videoNodeRef.remove();

                    for (let i = 0; i < totalChunks; i++) {
                        const part = fullDataUrl.slice(i * chunkSize, (i + 1) * chunkSize);
                        await videoNodeRef.child('chunks/' + i).set(part);
                        if (btnLabel) {
                            const pct = Math.round(((i + 1) / totalChunks) * 100);
                            btnLabel.innerText = `⏳ Загрузка для ученика: ${pct}%...`;
                        }
                    }

                    await videoNodeRef.child('meta').set({
                        totalChunks,
                        name: file.name,
                        updatedAt: Date.now()
                    });

                    if (btnLabel) btnLabel.innerText = `✅ Готово (${file.name.slice(0, 22)})`;
                    broadcastEvent({ type: 'video_chunks_ready', id });
                } catch (err) {
                    if (btnLabel) btnLabel.innerText = '🎬 Выбрать другое видео';
                }
            };
            reader.readAsDataURL(file);
        }

        function base64DataUrlToBlob(dataUrl) {
            const parts = dataUrl.split(',');
            const rawMime = (parts[0].match(/:(.*?);/) || [])[1] || 'video/mp4';
            // Конвертируем iPad .mov (video/quicktime) в video/mp4 для воспроизведения на всех ПК и планшетах
            const mime = rawMime === 'video/quicktime' ? 'video/mp4' : rawMime;
            const bstr = atob(parts[1]);
            let n = bstr.length;
            const u8arr = new Uint8Array(n);
            while (n--) {
                u8arr[n] = bstr.charCodeAt(n);
            }
            return new Blob([u8arr], { type: mime });
        }

        function loadSyncedVideoFromFirebase(id) {
            if (!roomRef) return;
            roomRef.child(`videoFiles/${id}/meta`).on('value', async (metaSnap) => {
                const meta = metaSnap.val();
                if (!meta || !meta.totalChunks) return;
                const btnLabel = document.getElementById(`vid-btn-label-${id}`);
                if (btnLabel && role === 'teacher') {
                    btnLabel.innerText = `✅ Загружено (${(meta.name || 'Видео').slice(0, 20)})`;
                }
                try {
                    const chunksSnap = await roomRef.child(`videoFiles/${id}/chunks`).once('value');
                    const chunksVal = chunksSnap.val();
                    if (!chunksVal) return;

                    let fullDataUrl = '';
                    for (let i = 0; i < meta.totalChunks; i++) {
                        if (chunksVal[i]) fullDataUrl += chunksVal[i];
                    }
                    if (!fullDataUrl) return;

                    const blob = base64DataUrlToBlob(fullDataUrl);
                    const v = document.querySelector(`#${id} video`);
                    if (v) {
                        v.src = URL.createObjectURL(blob);
                        v.load();
                    }
                } catch (e) {}
            });
        }
        
