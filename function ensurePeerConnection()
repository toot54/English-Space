    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyAmlK0KFtxAWUNdEw8OEK0sZzWgf_KUIyE",
            authDomain: "english-space-13381.firebaseapp.com",
            databaseURL: "https://english-space-13381-default-rtdb.firebaseio.com",
            projectId: "english-space-13381",
            storageBucket: "english-space-13381.firebasestorage.app",
            messagingSenderId: "54553238353",
            appId: "1:54553238353:web:e269ccf594e77f21bad170",
            measurementId: "G-RQ2YW5CYV7"
        };

        let db = null, auth = null, roomRef = null;
        const urlParams = new URLSearchParams(window.location.search);
        const rawRoom = urlParams.get('room') || 'default_room';
        const ROOM_ID = rawRoom.replace(/[^a-zA-Z0-9_-]/g, '_');
        const LOCAL_BOARD_KEY = 'es_board_cache_' + ROOM_ID;
        const localChannel = new BroadcastChannel('es_live_' + ROOM_ID);

        try {
            firebase.initializeApp(firebaseConfig);
            auth = firebase.auth();
            db = firebase.database();
            roomRef = db.ref('boards/' + ROOM_ID);
        } catch (e) {}

        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');
        const tempCanvas = document.getElementById('temp-canvas');
        const tempCtx = tempCanvas.getContext('2d');

        const boardWorld = document.getElementById('board-world');
        const viewport = document.getElementById('board-viewport');
        const laserCursor = document.getElementById('laser-cursor');
        const widgetsModal = document.getElementById('widgets-modal');
        const dynamicItems = document.getElementById('dynamic-items');
        const videoDock = document.getElementById('video-dock');
        const toolPopover = document.getElementById('tool-popover');
        const colorPopover = document.getElementById('color-popover');
        const lessonTimePopover = document.getElementById('lesson-time-popover');
        const placementBanner = document.getElementById('placement-banner');
        const remoteVoicePlayer = document.getElementById('remote-voice-player');

        const CENTER_X = -1400;
        const CENTER_Y = -950;

        function detectInitialRole() {
            const paramRole = urlParams.get('role');
            if (paramRole === 'teacher' || paramRole === 'student') return paramRole;
            for (let i = 0; i < localStorage.length; i++) {
                const k = localStorage.key(i);
                if (k && k.startsWith('es_role_')) {
                    const r = localStorage.getItem(k);
                    if (r === 'teacher' || r === 'student') return r;
                }
            }
            return 'teacher';
        }

        let role = detectInitialRole();
        let myClientId = 'cl_' + Math.random().toString(36).slice(2, 9);
        let tool = 'marker';
        let lastDrawTool = 'marker';
        let currentColor = '#4f46e5';
        let baseStrokeSize = 5;

        let drawing = false;
        let panning = false;
        let followMode = true;
        let boardX = CENTER_X, boardY = CENTER_Y;
        let boardScale = 1;

        // Целевые координаты для плавного ведения ученика (60 FPS без рывков)
        let targetFollowX = CENTER_X;
        let targetFollowY = CENTER_Y;
        let targetFollowScale = 1;

        let startPanX = 0, startPanY = 0;
        let currentStrokePoints = [];
        let strokeBounds = { minX: 0, minY: 0, maxX: 0, maxY: 0 };

        // Отдельные z-index: для фото (15..22 — ПОД маркером) и для остальных виджетов (35..48 — НАД маркером)
        let photoZIndex = 15;
        let topZIndex = 35;

        let pendingWidgetType = null;
        let strokeHistory = [];
        let actionHistory = [];
        let redoActionStack = [];

        let timerInterval = null;
        let remainingSeconds = 0;
        let timerPaused = false;
        let selectedDelayMinutes = 0;
        let timerPhase = 'lesson';
        let scheduledDurationMins = 60;
        let lastMoveSentTime = 0;

        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        tempCtx.lineCap = 'round';
        tempCtx.lineJoin = 'round';

        applyVerifiedRole(role);
        applyBoardTransform();

        // Плавный цикл интерполяции камеры для ученика в режиме "Вести"
        function startSmoothFollowLoop() {
            function step() {
                if (role === 'student' && followMode) {
                    const dx = targetFollowX - boardX;
                    const dy = targetFollowY - boardY;
                    const ds = targetFollowScale - boardScale;
                    if (Math.abs(dx) > 0.4 || Math.abs(dy) > 0.4 || Math.abs(ds) > 0.002) {
                        boardX += dx * 0.22;
                        boardY += dy * 0.22;
                        boardScale += ds * 0.22;
                        updateZoomUI();
                        applyBoardTransform();
                    }
                }
                requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }
        startSmoothFollowLoop();

        if (auth && !urlParams.get('role')) {
            auth.onAuthStateChanged(async (user) => {
                if (!user) return;
                const cachedRole = localStorage.getItem('es_role_' + user.uid) || user.photoURL;
                if (cachedRole === 'teacher' || cachedRole === 'student') {
                    applyVerifiedRole(cachedRole);
                } else if (db) {
                    try {
                        const snap = await db.ref(`users/${user.uid}/role`).once('value');
                        if (snap.val()) applyVerifiedRole(snap.val());
                    } catch (e) {}
                }
            });
        }

        function setRole(newRole) {
            applyVerifiedRole(newRole);
        }

        function applyVerifiedRole(verifiedRole) {
            role = (verifiedRole === 'student') ? 'student' : 'teacher';
            document.body.className = 'role-' + role;
            updateStudentPanLock();
            updateLaserVisibility();
        }

        function exitToCabinet() {
            saveBoardState();
            cleanupWebRTC();
            if (window.parent && window.parent !== window && typeof window.parent.closeBoardRoom === 'function') {
                window.parent.closeBoardRoom();
            } else {
                window.location.href = 'index.html';
            }
        }

        function broadcastEvent(payload) {
            const msg = { ...payload, sender: myClientId, ts: Date.now() };
            try { localChannel.postMessage(msg); } catch (e) {}
            if (roomRef) {
                try { roomRef.child('events').push(msg).catch(() => {}); } catch (e) {}
            }
        }

        localChannel.onmessage = (ev) => {
            if (ev.data && ev.data.sender !== myClientId) {
                handleRemoteEvent(ev.data);
            }
        };

        function restoreSnapshotData(val) {
            if (!val) return;
            if (val.strokeHistory) {
                strokeHistory = val.strokeHistory;
                redrawAllStrokes();
            }
            if (val.items && Array.isArray(val.items)) {
                dynamicItems.innerHTML = '';
                val.items.forEach(item => {
                    if (item.type === 'video') createVideoWidget(item, false, false);
                    else if (item.type === 'essay') createEssayWidget(item, false, false);
                    else if (item.type === 'photo') spawnPhotoWidget(item, false, false);
                    else if (item.type === 'sticker') createSticker(item, false, false);
                    else if (item.type === 'speaking') createSpeakingWidget(item, false, false);
                    else if (item.type === 'dict') createDictWidget(item, false, false);
                    else if (item.type === 'text') createTextNode(item, false, false);
                });
            }
        }

        function initRealtimeSync() {
            try {
                const localRaw = localStorage.getItem(LOCAL_BOARD_KEY);
                if (localRaw) restoreSnapshotData(JSON.parse(localRaw));
            } catch (e) {}

            if (!roomRef) return;
            try {
                roomRef.child('snapshot').once('value', (snap) => {
                    const val = snap.val();
                    if (val) restoreSnapshotData(val);
                });

                roomRef.child('teacherMove').on('value', (snap) => {
                    const data = snap.val();
                    if (!data || data.sender === myClientId) return;
                    handleTeacherMoveData(data);
                });

                // Слушаем новые события без привязки к системным часам устройства
                let initialEventsSkipped = false;
                roomRef.child('events').limitToLast(1).on('child_added', (snap) => {
                    if (!initialEventsSkipped) {
                        initialEventsSkipped = true;
                        return;
                    }
                    const data = snap.val();
                    if (!data || data.sender === myClientId) return;
                    handleRemoteEvent(data);
                });
            } catch (e) {}
        }

        function sendTeacherViewportSync(worldX, worldY) {
            if (role !== 'teacher') return;
            const pointerActive = (tool === 'pointer');
            const movePayload = {
                type: 'teacher_move_local',
                sender: myClientId,
                worldX: worldX !== undefined ? worldX : Math.round((window.innerWidth / 2 - boardX) / boardScale),
                worldY: worldY !== undefined ? worldY : Math.round((window.innerHeight / 2 - boardY) / boardScale),
                boardX, boardY, boardScale,
                vw: window.innerWidth,
                vh: window.innerHeight,
                followMode, pointerActive
            };
            try { localChannel.postMessage(movePayload); } catch (err) {}
            if (roomRef) {
                try { roomRef.child('teacherMove').set(movePayload).catch(() => {}); } catch (err) {}
            }
        }

        function handleTeacherMoveData(data) {
            followMode = data.followMode;
            updateStudentPanLock();
            laserCursor.style.display = data.pointerActive ? 'block' : 'none';
            if (data.pointerActive && data.worldX !== undefined) {
                laserCursor.style.left = data.worldX + 'px';
                laserCursor.style.top = data.worldY + 'px';
            }

            if (role === 'student' && followMode) {
                const tScale = data.boardScale || 1;
                targetFollowScale = tScale;

                // Выравниваем центр экрана учителя и центр экрана ученика
                const tVw = data.vw || window.innerWidth;
                const tVh = data.vh || window.innerHeight;
                const centerWorldX = (tVw / 2 - data.boardX) / tScale;
                const centerWorldY = (tVh / 2 - data.boardY) / tScale;

                const minX = Math.min(0, window.innerWidth - canvas.width * tScale);
                const minY = Math.min(0, window.innerHeight - canvas.height * tScale);

                targetFollowX = Math.min(0, Math.max(minX, window.innerWidth / 2 - centerWorldX * tScale));
                targetFollowY = Math.min(0, Math.max(minY, window.innerHeight / 2 - centerWorldY * tScale));
            }
        }

        const pencilPatternCache = {};
        function getPencilPattern(colorHex) {
            if (pencilPatternCache[colorHex]) return pencilPatternCache[colorHex];
            const pCanvas = document.createElement('canvas');
            pCanvas.width = 24; pCanvas.height = 24;
            const pCtx = pCanvas.getContext('2d');
            pCtx.fillStyle = colorHex;
            for (let x = 0; x < 24; x++) {
                for (let y = 0; y < 24; y++) {
                    const rnd = Math.random();
                    if (rnd > 0.32) {
                        pCtx.globalAlpha = rnd * 0.85;
                        pCtx.fillRect(x, y, 1.3, 1.3);
                    }
                }
            }
            const pattern = ctx.createPattern(pCanvas, 'repeat');
            pencilPatternCache[colorHex] = pattern;
            return pattern;
        }

