        function processImageFile(file, targetX, targetY) {
            const reader = new FileReader();
            reader.onload = (e) => {
                const img = new Image();
                img.onload = () => {
                    const offCanvas = document.createElement('canvas');
                    const maxW = 900;
                    const scale = img.width > maxW ? maxW / img.width : 1;
                    offCanvas.width = Math.round(img.width * scale);
                    offCanvas.height = Math.round(img.height * scale);
                    offCanvas.getContext('2d').drawImage(img, 0, 0, offCanvas.width, offCanvas.height);
                    const dataUrl = offCanvas.toDataURL('image/jpeg', 0.82);

                    const aspect = offCanvas.width / offCanvas.height;
                    const initW = Math.min(340, window.innerWidth - 40);
                    const initH = Math.round((initW - 12) / aspect) + 32;

                    const itemData = {
                        id: 'photo-' + Date.now(),
                        left: Math.round(targetX),
                        top: Math.round(targetY),
                        width: initW,
                        height: initH,
                        aspect: aspect,
                        src: dataUrl
                    };
                    spawnPhotoWidget(itemData, true, true);
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

