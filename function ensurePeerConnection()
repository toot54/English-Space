        async function lookupDictionary(id, broadcast, wordOverride) {
            const inputEl = document.getElementById(`dict-in-${id}`);
            const bodyEl = document.getElementById(`dict-body-${id}`);
            const camLink = document.getElementById(`cam-link-${id}`);
            const oxfLink = document.getElementById(`oxf-link-${id}`);
            if (!inputEl || !bodyEl) return;

            const word = (wordOverride || inputEl.value).trim().toLowerCase();
            if (!word) return;
            inputEl.value = word;

            camLink.href = `https://dictionary.cambridge.org/dictionary/english-russian/${encodeURIComponent(word)}`;
            oxfLink.href = `https://www.oxfordlearnersdictionaries.com/definition/english/${encodeURIComponent(word)}`;
            bodyEl.innerHTML = '⏳ Поиск в словарной базе...';

            if (broadcast) broadcastEvent({ type: 'dict_lookup', id, word });

            try {
                const [oxRes, trRes] = await Promise.allSettled([
                    fetch(`https://api.dictionaryapi.dev/api/v2/entries/en/${encodeURIComponent(word)}`).then(r => r.json()),
                    fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(word)}&langpair=en|ru`).then(r => r.json())
                ]);

                let html = '';
                const ruWord = (trRes.status === 'fulfilled' && trRes.value?.responseData?.translatedText)
                    ? trRes.value.responseData.translatedText : '';

                if (oxRes.status === 'fulfilled' && Array.isArray(oxRes.value) && oxRes.value.length > 0) {
                    const entry = oxRes.value[0];
                    const phonetic = entry.phonetic || (entry.phonetics?.find(p => p.text)?.text) || '';
                    const audioUrl = entry.phonetics?.find(p => p.audio)?.audio || '';

                    html += `<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px;">
