        let rtcSignalRef = null;

        function setRtcStatus(text) {
            const el = document.getElementById('rtc-status-bar');
            if (el) el.innerText = text;
        }

        function sendRtcSignal(payload) {
            const msg = { ...payload, type: 'webrtc_signal', sender: myClientId, senderRole: role, ts: Date.now() };
            try { localChannel.postMessage(msg); } catch (e) {}
            if (rtcSignalRef) {
                try { rtcSignalRef.push(msg).catch(() => {}); } catch (e) {}
            }
        }

        function ensurePeerConnection() {
            if (pc && pc.connectionState !== 'closed' && pc.connectionState !== 'failed') {
                return pc;
            }
            if (pc) {
                try { pc.close(); } catch (e) {}
            }

            pc = new RTCPeerConnection(RTC_CONFIG);
            remoteVideoStream = new MediaStream();

            if (localStream) {
                localStream.getTracks().forEach(track => {
                    pc.addTrack(track, localStream);
                });
            }

            pc.onicecandidate = (e) => {
                if (e.candidate) {
                    sendRtcSignal({ kind: 'ice', candidate: e.candidate.toJSON() });
                }
            };

            pc.onconnectionstatechange = () => {
                if (!pc) return;
                if (pc.connectionState === 'connected') {
                    setRtcStatus('🟢 Видео и звук подключены');
                } else if (pc.connectionState === 'connecting') {
                    setRtcStatus('⏳ Соединение...');
                } else if (pc.connectionState === 'failed' || pc.connectionState === 'disconnected') {
                    setRtcStatus('🔄 Нажмите для переподключения');
                }
            };

            pc.ontrack = (e) => {
                const targetSlot = (role === 'teacher') ? 'student' : 'teacher';
                const videoEl = document.getElementById(targetSlot === 'teacher' ? 'teacherVideo' : 'studentVideo');
                const placeholderEl = document.getElementById(targetSlot === 'teacher' ? 'teacher-placeholder' : 'student-placeholder');

                if (e.streams && e.streams[0]) {
                    remoteVideoStream = e.streams[0];
                } else {
                    const existing = remoteVideoStream.getTracks().find(t => t.kind === e.track.kind);
                    if (existing) remoteVideoStream.removeTrack(existing);
                    remoteVideoStream.addTrack(e.track);
                }

                if (videoEl) {
                    // Переприсваиваем поток, чтобы Safari на iPad сразу отрисовал картинку и включил звук
                    videoEl.srcObject = null;
                    videoEl.srcObject = remoteVideoStream;
                    videoEl.muted = remoteSoundMuted;
                    videoEl.play().catch(() => {
                        // Если iPad заблокировал автозвук до первого касания — запускаем видео и включаем звук при касании экрана
                        videoEl.muted = true;
                        videoEl.play().catch(() => {});
                        setRtcStatus('🔊 Коснитесь экрана для включения звука');
                    });
                }

                if (e.track.kind === 'video' && placeholderEl) {
                    placeholderEl.style.display = 'none';
                }
                setRtcStatus('🟢 Видео и звук подключены');
            };

            return pc;
        }

        async function makeWebRTCOffer() {
            const conn = ensurePeerConnection();
            try {
                makingOffer = true;
                const offer = await conn.createOffer({
                    offerToReceiveAudio: true,
                    offerToReceiveVideo: true
                });
                if (conn.signalingState !== 'stable') return;
                await conn.setLocalDescription(offer);
                sendRtcSignal({
                    kind: 'sdp',
                    description: { type: conn.localDescription.type, sdp: conn.localDescription.sdp },
                    hasVideo: cameraActive,
                    hasAudio: micActive
                });
            } catch (e) {
                console.warn('Offer error:', e);
            } finally {
                makingOffer = false;
            }
        }

        async function handleWebRTCSignal(data) {
            if (!data || data.sender === myClientId) return;
            const conn = ensurePeerConnection();
            const polite = (role === 'student') || (myClientId < data.sender);

            try {
                if (data.kind === 'hello') {
                    sendRtcSignal({ kind: 'media_state', hasVideo: cameraActive, hasAudio: micActive });
                    await makeWebRTCOffer();
                } else if (data.kind === 'sdp' && data.description) {
                    const desc = data.description;
                    const offerCollision = (desc.type === 'offer') && (makingOffer || conn.signalingState !== 'stable');
                    ignoreOffer = !polite && offerCollision;
                    if (ignoreOffer) return;

                    if (offerCollision) {
                        await Promise.all([
                            conn.setLocalDescription({ type: 'rollback' }),
                            conn.setRemoteDescription(new RTCSessionDescription(desc))
                        ]);
                    } else {
                        await conn.setRemoteDescription(new RTCSessionDescription(desc));
                    }

                    while (pendingIceCandidates.length > 0) {
                        const c = pendingIceCandidates.shift();
                        try { await conn.addIceCandidate(new RTCIceCandidate(c)); } catch (err) {}
                    }

                    if (desc.type === 'offer') {
                        const answer = await conn.createAnswer();
                        await conn.setLocalDescription(answer);
                        sendRtcSignal({
                            kind: 'sdp',
                            description: { type: conn.localDescription.type, sdp: conn.localDescription.sdp },
                            hasVideo: cameraActive,
                            hasAudio: micActive
                        });
                    }
                    if (data.hasVideo !== undefined || data.hasAudio !== undefined) {
                        const targetSlot = (role === 'teacher') ? 'student' : 'teacher';
                        updateRemotePlaceholder(targetSlot, data.hasVideo, data.hasAudio);
                    }
                } else if (data.kind === 'ice' && data.candidate) {
                    if (conn.remoteDescription && conn.remoteDescription.type) {
                        try { await conn.addIceCandidate(new RTCIceCandidate(data.candidate)); } catch (err) {}
                    } else {
                        pendingIceCandidates.push(data.candidate);
                    }
                } else if (data.kind === 'media_state') {
                    const targetSlot = (role === 'teacher') ? 'student' : 'teacher';
                    updateRemotePlaceholder(targetSlot, data.hasVideo, data.hasAudio);
                }
            } catch (err) {
                console.warn('WebRTC signal error:', err);
            }
        }

        function initWebRTC() {
            ensurePeerConnection();
            if (roomRef) {
                rtcSignalRef = roomRef.child('rtcSignals');
                // Очищаем старые сигналы прошлых уроков и слушаем все новые без рассинхрона часов
                rtcSignalRef.remove().then(() => {
                    rtcSignalRef.on('child_added', (snap) => {
                        const val = snap.val();
                        if (!val || val.sender === myClientId) return;
                        handleWebRTCSignal(val);
                    });
                    sendRtcSignal({ kind: 'hello' });
                }).catch(() => {});
            }
        }

        function reconnectWebRTC() {
            unlockAudioPlayback();
            setRtcStatus('🔄 Обновление связи...');
            if (pc) {
                try { pc.close(); } catch (e) {}
                pc = null;
            }
            ensurePeerConnection();
            sendRtcSignal({ kind: 'hello' });
            makeWebRTCOffer();
        }

        function cleanupWebRTC() {
            if (localStream) {
                localStream.getTracks().forEach(t => t.stop());
            }
            if (pc) {
                try { pc.close(); } catch (e) {}
            }
        }

        function unlockAudioPlayback() {
            const remoteSlot = (role === 'teacher') ? 'studentVideo' : 'teacherVideo';
            const remoteVid = document.getElementById(remoteSlot);
            if (remoteVid && remoteVid.srcObject) {
                remoteVid.muted = remoteSoundMuted;
                remoteVid.play().catch(() => {});
            }
        }

        function updateRemotePlaceholder(slotRole, hasVideo, hasAudio) {
            const placeholderEl = document.getElementById(slotRole === 'teacher' ? 'teacher-placeholder' : 'student-placeholder');
            if (!placeholderEl) return;
            placeholderEl.style.display = hasVideo ? 'none' : 'block';
            const label = slotRole === 'teacher' ? '👩‍🏫 Учитель' : '🧑‍🎓 Ученик';
            placeholderEl.innerText = hasAudio ? `${label} (🎙️ Говорит)` : `${label}`;
        }

        function showLocalPreview() {
            const videoEl = document.getElementById(role === 'teacher' ? 'teacherVideo' : 'studentVideo');
            const placeholderEl = document.getElementById(role === 'teacher' ? 'teacher-placeholder' : 'student-placeholder');
            if (!videoEl || !placeholderEl) return;

            videoEl.muted = true; // Свой собственный голос всегда глушим локально, чтобы не слышать эхо
            if (cameraActive && localStream) {
                videoEl.srcObject = null;
                videoEl.srcObject = localStream;
                videoEl.play().catch(() => {});
                placeholderEl.style.display = 'none';
            } else {
                videoEl.srcObject = null;
                placeholderEl.style.display = 'block';
                const label = role === 'teacher' ? '👩‍🏫 Камера учителя' : '🧑‍🎓 Камера ученика';
                placeholderEl.innerText = micActive ? `${label} (🎙️ Голос активен)` : label;
            }
        }

        async function attachOrReplaceTrack(newTrack) {
            const conn = ensurePeerConnection();
            const sender = conn.getSenders().find(s => s.track && s.track.kind === newTrack.kind);
            if (sender) {
                await sender.replaceTrack(newTrack);
            } else {
                conn.addTrack(newTrack, localStream);
            }
            sendRtcSignal({ kind: 'media_state', hasVideo: cameraActive, hasAudio: micActive });
            await makeWebRTCOffer();
        }

        async function toggleMic() {
            unlockAudioPlayback();
            const micBtn = document.getElementById('btn-mic-toggle');
            const micText = document.getElementById('mic-btn-text');

            if (localStream && localStream.getAudioTracks().length > 0) {
                micActive = !micActive;
                localStream.getAudioTracks().forEach(t => t.enabled = micActive);
                micBtn.classList.toggle('lit', micActive);
                micText.innerText = micActive ? '🎙️ Микрофон вкл' : '🔇 Микрофон выкл';
                showLocalPreview();
                sendRtcSignal({ kind: 'media_state', hasVideo: cameraActive, hasAudio: micActive });
                return;
            }

            try {
                const audioStream = await navigator.mediaDevices.getUserMedia({
                    audio: { echoCancellation: true, noiseSuppression: true },
                    video: false
                });
                const audioTrack = audioStream.getAudioTracks()[0];
                if (!localStream) localStream = new MediaStream();
                localStream.addTrack(audioTrack);

                micActive = true;
                micBtn.classList.add('lit');
                micText.innerText = '🎙️ Микрофон вкл';
                showLocalPreview();
                await attachOrReplaceTrack(audioTrack);
            } catch (err) {
                alert('Разрешите доступ к микрофону в настройках Safari / браузера.');
            }
        }

        function toggleRemoteSound() {
            remoteSoundMuted = !remoteSoundMuted;
            const soundBtn = document.getElementById('btn-sound-toggle');
            const soundText = document.getElementById('sound-btn-text');
            soundBtn.classList.toggle('lit', !remoteSoundMuted);
            soundText.innerText = remoteSoundMuted ? '🔇 Звук выкл' : '🔊 Звук';

            const remoteSlot = (role === 'teacher') ? 'studentVideo' : 'teacherVideo';
            const remoteVid = document.getElementById(remoteSlot);
            if (remoteVid) {
                remoteVid.muted = remoteSoundMuted;
                if (!remoteSoundMuted) remoteVid.play().catch(() => {});
            }
        }

        async function toggleCamera() {
            unlockAudioPlayback();
            const camBtn = document.getElementById('btn-cam-toggle');

            if (cameraActive && localStream) {
                localStream.getVideoTracks().forEach(track => {
                    track.stop();
                    localStream.removeTrack(track);
                });
                cameraActive = false;
                camBtn.classList.remove('lit');
                showLocalPreview();
                sendRtcSignal({ kind: 'media_state', hasVideo: cameraActive, hasAudio: micActive });
                await makeWebRTCOffer();
                return;
            }

            try {
                const needAudio = !localStream || localStream.getAudioTracks().length === 0;
                const media = await navigator.mediaDevices.getUserMedia({
                    video: { width: { ideal: 480 }, height: { ideal: 360 }, facingMode: 'user' },
                    audio: needAudio ? { echoCancellation: true, noiseSuppression: true } : false
                });

                if (!localStream) localStream = new MediaStream();

                const videoTrack = media.getVideoTracks()[0];
                if (videoTrack) {
                    localStream.addTrack(videoTrack);
                    cameraActive = true;
                    camBtn.classList.add('lit');
                    await attachOrReplaceTrack(videoTrack);
                }

                const audioTrack = media.getAudioTracks()[0];
                if (audioTrack) {
                    localStream.addTrack(audioTrack);
                    micActive = true;
                    document.getElementById('btn-mic-toggle').classList.add('lit');
                    document.getElementById('mic-btn-text').innerText = '🎙️ Микрофон вкл';
                    await attachOrReplaceTrack(audioTrack);
                }

                toggleVideoDock(true);
                showLocalPreview();
            } catch (err) {
                alert('Разрешите доступ к камере и микрофону в настройках браузера.');
            }
        }

        initRealtimeSync();
        initWebRTC();
    </script>
