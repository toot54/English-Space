        };

        let pc = null;
        let localStream = null;
        let remoteVideoStream = new MediaStream();
        let remoteAudioStream = new MediaStream();
        let micActive = false;
        let cameraActive = false;
        let remoteSoundMuted = false;
        let makingOffer = false;
        let ignoreOffer = false;
