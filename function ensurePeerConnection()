        function toggleSpeakingTimer(id, broadcast) {
            const st = speakingTimers[id];
            if (!st) return;
            st.running = !st.running;

            if (st.interval) clearInterval(st.interval);
            if (st.running) {
                st.interval = setInterval(() => {
                    if (st.remaining > 0) {
                        st.remaining--;
                        updateSpeakingClockUI(id);
                    } else {
                        clearInterval(st.interval);
                        st.running = false;
                        updateSpeakingClockUI(id);
                    }
                }, 1000);
            }
            updateSpeakingClockUI(id);
            if (broadcast) broadcastEvent({ type: 'speaking_toggle_timer', id, running: st.running, remaining: st.remaining });
        }

        function updateSpeakingClockUI(id) {
            const st = speakingTimers[id];
            const clockEl = document.getElementById(`spk-clock-${id}`);
            const startBtn = document.getElementById(`spk-start-${id}`);
            if (!st || !clockEl || !startBtn) return;

            const m = Math.floor(st.remaining / 60);
            const s = st.remaining % 60;
            clockEl.innerText = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
            startBtn.innerText = st.running ? '⏹️ Стоп' : '▶️ Старт';
            startBtn.classList.toggle('running', st.running);
        }

        async function toggleSpeakingRecord(id) {
            const btn = document.getElementById(`spk-rec-${id}`);
            const audioEl = document.getElementById(`spk-audio-${id}`);
            if (!btn || !audioEl) return;

            if (speakingRecorders[id] && speakingRecorders[id].state === 'recording') {
                speakingRecorders[id].stop();
                btn.classList.remove('recording');
                btn.innerText = '🔴 Запись';
                return;
            }

            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                const recorder = new MediaRecorder(stream);
                const chunks = [];
                speakingRecorders[id] = recorder;

                recorder.ondataavailable = (e) => { if (e.data.size > 0) chunks.push(e.data); };
                recorder.onstop = () => {
                    stream.getTracks().forEach(t => t.stop());
                    const blob = new Blob(chunks, { type: 'audio/webm' });
                    const reader = new FileReader();
                    reader.onloadend = () => {
                        const base64Audio = reader.result;
                        audioEl.src = base64Audio;
                        broadcastEvent({ type: 'speaking_audio', id, src: base64Audio });
                    };
                    reader.readAsDataURL(blob);
                };

                recorder.start();
                btn.classList.add('recording');
                btn.innerText = '⏹️ Стоп';
            } catch (err) {
                alert('Разрешите доступ к микрофону в браузере.');
            }
        }

