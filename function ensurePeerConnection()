        function changeZoom(delta, centerClientX, centerClientY) {
            if (role === 'student' && followMode) return;
            const oldScale = boardScale;
            boardScale = Math.min(2.4, Math.max(0.45, +(boardScale + delta).toFixed(2)));
            if (oldScale === boardScale) return;

            const cx = centerClientX !== undefined ? centerClientX : window.innerWidth / 2;
            const cy = centerClientY !== undefined ? centerClientY : window.innerHeight / 2;

            const worldCenterX = (cx - boardX) / oldScale;
            const worldCenterY = (cy - boardY) / oldScale;

            boardX = cx - worldCenterX * boardScale;
            boardY = cy - worldCenterY * boardScale;

            updateZoomUI();
            applyBoardTransform();

            if (role === 'teacher') {
                sendTeacherViewportSync();
            }
        }

        function resetZoom() {
            if (role === 'student' && followMode) return;
