                            <b style="font-size:15px; color:#1e293b;">${entry.word}</b>
                            <span style="color:#4f46e5; font-weight:700; margin-left:6px;">${phonetic}</span>
                        </div>
                        ${audioUrl ? `<button onclick="new Audio('${audioUrl}').play()" style="border:none; background:#eef2ff; color:#4f46e5; padding:3px 8px; border-radius:6px; cursor:pointer; font-weight:700; font-size:11px;">🔊 Звук</button>` : ''}
                    </div>`;

                    if (ruWord) {
                        html += `<div style="background:#eef2ff; color:#312e81; padding:5px 8px; border-radius:6px; font-weight:700; margin-bottom:8px;">
                            🇷🇺 Перевод: ${ruWord}
                        </div>`;
                    }

                    entry.meanings.slice(0, 2).forEach(m => {
                        html += `<div style="margin-bottom:6px;">
                            <span style="font-size:10px; font-weight:800; text-transform:uppercase; background:#e2e8f0; padding:2px 6px; border-radius:4px; color:#334155;">${m.partOfSpeech}</span>`;
                        m.definitions.slice(0, 2).forEach((d, idx) => {
                            html += `<div style="margin-top:4px;"><b>${idx + 1}.</b> ${d.definition}</div>`;
                        });
                        html += `</div>`;
                    });
                } else if (ruWord) {
                    html = `<div style="font-weight:700; font-size:14px; margin-bottom:6px;">${word}</div>
                            <div style="background:#eef2ff; color:#312e81; padding:6px 8px; border-radius:6px; font-weight:700;">🇷🇺 ${ruWord}</div>`;
                } else {
                    html = `Слово не найдено. Откройте прямую статью Cambridge / Oxford по кнопкам ниже.`;
                }
                bodyEl.innerHTML = html;
            } catch (err) {
                bodyEl.innerHTML = `Воспользуйтесь кнопками Cambridge / Oxford ниже.`;
            }
