        function recordAction(action) {
            actionHistory.push(action);
            redoActionStack = [];
            saveBoardState();
        }

        function undoAction() {
            if (actionHistory.length === 0) return;
            const act = actionHistory.pop();
            redoActionStack.push(act);

            if (act.kind === 'stroke') {
                strokeHistory.pop();
                redrawAllStrokes();
                broadcastEvent({ type: 'strokes_sync', strokeHistory });
            } else if (act.kind === 'add_item') {
                const el = document.getElementById(act.id);
                if (el) {
                    const v = el.querySelector('video');
                    if (v) v.pause();
                    el.style.display = 'none';
                    broadcastEvent({ type: 'item_display', id: act.id, display: 'none' });
                }
            } else if (act.kind === 'remove_item') {
                const el = document.getElementById(act.id);
                if (el) {
                    el.style.display = act.prevDisplay || 'flex';
                    broadcastEvent({ type: 'item_display', id: act.id, display: el.style.display });
                }
            } else if (act.kind === 'move_item') {
                const el = document.getElementById(act.id);
                if (el) {
                    el.style.left = act.fromLeft + 'px';
                    el.style.top = act.fromTop + 'px';
                    broadcastEvent({ type: 'widget_move', id: act.id, left: act.fromLeft, top: act.fromTop });
                }
            } else if (act.kind === 'resize_item') {
                const el = document.getElementById(act.id);
                if (el) {
                    el.style.width = act.fromW + 'px';
                    el.style.height = act.fromH + 'px';
                    broadcastEvent({ type: 'widget_resize', id: act.id, width: act.fromW, height: act.fromH });
                }
            }
            saveBoardState();
        }

        function redoAction() {
            if (redoActionStack.length === 0) return;
            const act = redoActionStack.pop();
            actionHistory.push(act);

            if (act.kind === 'stroke') {
                strokeHistory.push(act.stroke);
                redrawAllStrokes();
                broadcastEvent({ type: 'strokes_sync', strokeHistory });
            } else if (act.kind === 'add_item') {
                const el = document.getElementById(act.id);
                if (el) {
                    el.style.display = act.display || 'flex';
                    broadcastEvent({ type: 'item_display', id: act.id, display: el.style.display });
                }
            } else if (act.kind === 'remove_item') {
                const el = document.getElementById(act.id);
                if (el) {
                    el.style.display = 'none';
                    broadcastEvent({ type: 'item_display', id: act.id, display: 'none' });
                }
            } else if (act.kind === 'move_item') {
                const el = document.getElementById(act.id);
                if (el) {
                    el.style.left = act.toLeft + 'px';
                    el.style.top = act.toTop + 'px';
                    broadcastEvent({ type: 'widget_move', id: act.id, left: act.toLeft, top: act.toTop });
                }
            } else if (act.kind === 'resize_item') {
                const el = document.getElementById(act.id);
                if (el) {
                    el.style.width = act.toW + 'px';
                    el.style.height = act.toH + 'px';
                    broadcastEvent({ type: 'widget_resize', id: act.id, width: act.toW, height: act.toH });
                }
            }
            saveBoardState();
        }

        function redrawAllStrokes() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            strokeHistory.forEach(s => {
